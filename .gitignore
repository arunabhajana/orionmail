# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.sample
!.env.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sensitive data
accounts.json
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# graphify
/graphify-out

#claude
.claude

#antigravity
.agents


.sf/

# Rust build output and generated Tauri schemas
/target/
/src-tauri/target/
/src-tauri/gen/schemas/

# Local compiler diagnostics
/src-tauri/cargo_check.json
/src-tauri/errors.json

# Cargo registry metadata copied with the patched dependency
/src-tauri/vendor/**/.cargo-ok
/src-tauri/vendor/**/.cargo_vcs_info.json

# Editor and operating-system temporary files
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
/.idea/
